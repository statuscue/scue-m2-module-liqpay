<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <virtualType name="ScueLiqPayAdapter" type="Magento\Payment\Model\Method\Adapter">
        <arguments>
            <argument name="code" xsi:type="const">Scue\LiqPay\Api\Data\PaymentMethodCodeInterface::CODE</argument>
            <argument name="formBlockType" xsi:type="string">Magento\Payment\Block\Form\Cc</argument>
            <argument name="infoBlockType" xsi:type="string">ScueLiqPayConfigurableInfo</argument>
            <argument name="valueHandlerPool" xsi:type="object">ScueLiqPayValueHandlerPool</argument>
            <argument name="commandPool" xsi:type="object">ScueLiqPayCommandPool</argument>
            <argument name="validatorPool" xsi:type="object">ScueLiqPayValidatorPool</argument>
        </arguments>
    </virtualType>

    <virtualType name="ScueLiqPayConfigurableInfo" type="Magento\Payment\Block\ConfigurableInfo">
        <arguments>
            <argument name="data" xsi:type="array">
                <item name="methodCode" xsi:type="const">Scue\LiqPay\Api\Data\PaymentMethodCodeInterface::CODE</item>
            </argument>
        </arguments>
    </virtualType>

    <!-- Value Handler Pool Configuration -->
    <virtualType name="ScueLiqPayValueHandlerPool" type="Magento\Payment\Gateway\Config\ValueHandlerPool">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="default" xsi:type="string">ScueLiqPayConfigValueHandler</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="ScueLiqPayConfigValueHandler" type="Magento\Payment\Gateway\Config\ConfigValueHandler">
        <arguments>
            <argument name="configInterface" xsi:type="object">Scue\LiqPay\Gateway\Config\Config</argument>
        </arguments>
    </virtualType>
    <virtualType name="Scue\LiqPay\Gateway\Config\Config" type="Magento\Payment\Gateway\Config\Config">
        <arguments>
            <argument name="methodCode" xsi:type="const">Scue\LiqPay\Api\Data\PaymentMethodCodeInterface::CODE</argument>
        </arguments>
    </virtualType>
    <type name="Scue\LiqPay\Gateway\Config">
        <arguments>
            <argument name="config" xsi:type="object">Scue\LiqPay\Gateway\Config\Config</argument>
            <argument name="gatewayUrl" xsi:type="const">Scue\LiqPay\Api\Data\ApiUrlInterface::API_URL</argument>
        </arguments>
    </type>

    <!-- Command Pool Configuration -->
    <virtualType name="ScueLiqPayCommandPool" type="Magento\Payment\Gateway\Command\CommandPool">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="initialize" xsi:type="string">Scue\LiqPay\Gateway\Command\Initialize</item>
            </argument>
        </arguments>
    </virtualType>

    <!-- Validator Pool Configuration-->
    <virtualType name="ScueLiqPayValidatorPool" type="Magento\Payment\Gateway\Validator\ValidatorPool">
        <arguments>
            <argument name="validators" xsi:type="array">
                <item name="country" xsi:type="string">ScueLiqPayCountryValidator</item>
                <item name="currency" xsi:type="string">Scue\LiqPay\Gateway\Validator\CurrencyValidator</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="ScueLiqPayCountryValidator" type="Magento\Payment\Gateway\Validator\CountryValidator">
        <arguments>
            <argument name="config" xsi:type="object">Scue\LiqPay\Gateway\Config\Config</argument>
        </arguments>
    </virtualType>
    <type name="Scue\LiqPay\Gateway\Validator\CurrencyValidator">
        <arguments>
            <argument name="config" xsi:type="object">Scue\LiqPay\Gateway\Config\Config</argument>
        </arguments>
    </type>

    <preference for="Scue\LiqPay\Api\LiqPayCheckoutCallbackInterface" type="Scue\LiqPay\Model\Rest\Checkout\Callback"/>
</config>
